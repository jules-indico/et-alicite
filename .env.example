# AI summarization (OpenAI). NEVER commit real keys — this file is an example only.
# Copy to .env.local and fill in, then restart the dev server.
#
# Required for POST /api/summarize (source summaries on the detail page).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-4o-mini when unset.
# OPENAI_MODEL=gpt-4o-mini

# Neon Postgres (required). Pooled connection string from the Neon
# dashboard (or auto-injected as DATABASE_URL by the Vercel Marketplace
# Neon integration). Used by every API route via lib/server/db.ts.
# Get one at https://neon.tech (free tier available).
DATABASE_URL=

# Vercel Blob (required for uploads/avatars/research files). Read-write
# token from the Blob store settings (Vercel dashboard → Storage → Blob
# → your store → Settings). Used by lib/server/blob.ts.
BLOB_READ_WRITE_TOKEN=
